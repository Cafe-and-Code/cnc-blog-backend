# ===========================================
# Database Configuration
# ===========================================
MONGO_URI=mongodb://localhost:27017/cnc_blog

# ===========================================
# JWT Configuration
# ===========================================
ACCESS_TOKEN_SECRET=your-super-secret-access-token-key-here

# ===========================================
# Session Configuration
# ===========================================
SESSION_SECRET=demo-authentik-super-secret-session-key-2026

# ===========================================
# Application Configuration
# ===========================================
PORT=3001
HOST_NAME=0.0.0.0
BACKEND_URL=https://api.codeandcafe.com

# ===========================================
# CORS Configuration
# ===========================================
# Change this to your frontend URL in production (e.g. https://codeandcafe.com or https://blog.codeandcafe.com)
CORS_ORIGIN=http://localhost:3000

# ===========================================
# Authentik SSO Configuration
# ===========================================
# OIDC Issuer URL from Authentik application
AUTHENTIK_ISSUER=https://authentik.codeandcafe.com/application/o/local-cnc/
# Client ID from Authentik application
AUTHENTIK_CLIENT_ID=your-authentik-client-id
# Client Secret from Authentik application
AUTHENTIK_CLIENT_SECRET=your-authentik-client-secret
# Callback URL (should match Authentik application redirect URI)
AUTHENTIK_CALLBACK_URL=https://api.codeandcafe.com/auth/authentik/callback

# ===========================================
# App URL (for redirects)
# ===========================================
APP_URL=http://localhost:3000
